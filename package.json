{
  "name": "@morehao/dsh-github-trending",
  "version": "0.1.1",
  "description": "GitHub 趋势日报插件：每天定时 spawn 本地 trendradar 核心，抓取 Trending、生成中文简介与总结，提交到你的仓库并自动合并 PR。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./contract/*": "./contract/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "contract",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "trending",
    "daily-digest",
    "chinese",
    "trendradar"
  ],
  "engines": {
    "node": ">=22.20",
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "core": {
      "repo": "morehao/trendradar",
      "version": "0.1.0"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "tsup && node scripts/build-client.mjs",
    "build:host": "tsup",
    "build:client": "node scripts/build-client.mjs",
    "dev:client": "node scripts/build-client.mjs --watch",
    "typecheck": "tsc --noEmit",
    "gen:ipc": "node scripts/gen-ipc-types.mjs",
    "check:contract": "node scripts/sync-contract.mjs --check && node scripts/gen-ipc-types.mjs --check",
    "test": "node --test \"test/*.test.mjs\"",
    "pretest": "npm run build",
    "check": "npm run typecheck && npm run check:contract && npm run build && npm test",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "author": "morehao <morehao@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morehao/dsh-github-trending.git"
  },
  "bugs": "https://github.com/morehao/dsh-github-trending/issues",
  "homepage": "https://github.com/morehao/dsh-github-trending",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
